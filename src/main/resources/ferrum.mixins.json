{
  "required": true,
  "package": "cc.avie.ferrum.mixin",
  "plugin": "cc.avie.ferrum.FerrumMixinPlugin",
  "compatibilityLevel": "JAVA_25",
  "mixins": [
    "network.compression.CompressionDecoderMixin",
    "network.compression.CompressionEncoderMixin",
    "network.encryption.CipherDecoderMixin",
    "network.encryption.CipherEncoderMixin",
    "network.encryption.CryptMixin",
    "storage.compression.RegionFileVersionMixin",
    "storage.nbt.NbtIoMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
